# The two roots. Both are REQUIRED and both must be an absolute path.
# config.py reads them with no default and refuses to import if either is
# missing, empty or relative, so a fresh checkout stops with a message instead of
# building a folder tree in the wrong place. Replace both placeholders below.
#
# INTELLIBILLS_PRACTICE_ROOT is the synced practice folder and holds what is
# safe to sync: documents, backups, exports and the two registries.
# INTELLIBILLS_UNSYNCED_ROOT must be outside any synced folder and holds what
# is not: the live database and the process logs. Do not quote either value
# and do not escape the backslashes.
INTELLIBILLS_PRACTICE_ROOT=C:\Users\<you>\OneDrive - <Your Practice Name>
INTELLIBILLS_UNSYNCED_ROOT=C:\<a folder outside OneDrive>\Intellibills

# IMAP email settings (Krystal.io)
IMAP_HOST=mail.lastingimpact.co.uk
IMAP_PORT=993
IMAP_USERNAME=capture@lastingimpact.co.uk
IMAP_PASSWORD=your-email-password

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Extraction provider. Optional; defaults to openai_vision, which is the only
# engine registered today. An unrecognised value stops the pipeline at startup.
EXTRACTION_ENGINE=openai_vision

# Poll interval in seconds (300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Where IntelliBooks Desktop writes its resolution notes, per design document 12.2.
# Optional. Leave blank to use IntelliBooks\Resolutions under the practice root.
RESOLUTIONS_DIR=
